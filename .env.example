# Set to "true" to keep encoded files on disk after a successful upload
AVIDEO_KEEP_FILES=false

# Path overrides – only needed if ffmpeg/ffprobe/yt-dlp are not on your PATH
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# YTDLP_BIN=yt-dlp

# Folder for downloads and encodes (default: ~/.local/share/local-encoder/work)
# LOCAL_ENCODER_WORK_DIR=D:/videos/local-encoder
